# Copy to `.env.local` for local dev. Per-environment values are set by the EAS
# build profiles in eas.json (plan §10). Read in app.config.ts -> extra.apiBaseUrl
# -> src/lib/env.ts.

# Base URL of the ww-student-dashboard backend.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Report-card PDFs need NO env here: the API returns an ABSOLUTE public pdf_url
# (built from the partner portal's APP_BASE_URL), which the app downloads and
# opens directly — nothing to configure.
