# ══════════════════════════════════════════════════════════════════════════
# ww-student-app  (Expo / React Native student app)
# Copy to `.env.local` for local dev. Per-environment values for real builds
# come from the EAS build profiles in eas.json, NOT from this file.
# Read in app.config.ts -> extra.apiBaseUrl -> src/lib/env.ts.
# ══════════════════════════════════════════════════════════════════════════

# Base URL of the ww-student-dashboard backend. Every API call and every
# relative link in the app hangs off this.
#   local sim : http://localhost:3000
#   device on same wifi : http://<your-LAN-ip>:3000   (localhost = the phone)
#   staging   : https://dev.app.wiserwits.com
#   prod      : https://app.wiserwits.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Report-card PDFs need NO env here: the API returns pdf_url as a bare relPath
# and the app fetches it from EXPO_PUBLIC_API_BASE_URL via the authenticated
# /api/files proxy, with the student's own token. (Older rows may still hold an
# absolute URL from the previous public-URL scheme; those pass through as-is.)

# EAS_BUILD_PROFILE is set AUTOMATICALLY by EAS during `eas build` (development
# / staging / production, see eas.json). app.config.ts reads it only as a
# guard: a "staging" or "production" build FAILS unless
# EXPO_PUBLIC_API_BASE_URL is a real HTTPS URL. Do not set it by hand — a local
# `expo start` leaves it unset, which is the intended dev behaviour.
#
# NOTE: eas.json's production profile still carries the placeholder
# https://app.wiserwits.example/ — that build will fail the guard until the
# real prod host is filled in there.
